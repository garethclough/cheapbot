{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug lidar_node",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/lidar_node/build/lidar_node",
      "cwd": "${workspaceFolder}/lidar_node",
      "MIMode": "gdb",
      "preLaunchTask": "build lidar_node",
      "environment": [
        {
          "name": "LD_LIBRARY_PATH",
          "value": "/opt/ros/jazzy/opt/gz_sim_vendor/lib:/opt/ros/jazzy/opt/gz_sensors_vendor/lib:/opt/ros/jazzy/opt/gz_physics_vendor/lib:/opt/ros/jazzy/opt/sdformat_vendor/lib:/opt/ros/jazzy/lib/x86_64-linux-gnu:/opt/ros/jazzy/opt/gz_transport_vendor/lib:/opt/ros/jazzy/opt/gz_plugin_vendor/lib:/opt/ros/jazzy/opt/gz_msgs_vendor/lib:/opt/ros/jazzy/opt/gz_common_vendor/lib:/opt/ros/jazzy/opt/gz_math_vendor/lib:/opt/ros/jazzy/opt/gz_utils_vendor/lib:/opt/ros/jazzy/opt/gz_tools_vendor/lib:/opt/ros/jazzy/lib"
        }
      ],
      "setupCommands": [
        { "description": "Pretty-printing", "text": "-enable-pretty-printing", "ignoreFailures": true }
      ]
    }
  ]
}
